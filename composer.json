{
    "name": "congraph/entity-elastic",
    "description": "",
    "authors": [
        {
            "name": "Nikola Plavsic",
            "email": "nikolaplavsic@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../contracts",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../filesystem",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../locales",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../workflows",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../eav",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3 || ^8.4 || ^8.5",
        "illuminate/database": "^13.0",
        "congraph/core": "^2.0 || dev-main || dev-master",
        "congraph/contracts": "^2.0 || dev-main || dev-master",
        "congraph/filesystem": "^2.0 || dev-main || dev-master",
        "congraph/locales": "^2.0 || dev-main || dev-master",
        "congraph/workflows": "^2.0 || dev-main || dev-master",
        "congraph/eav": "^2.0 || dev-main || dev-master",
        "opensearch-project/opensearch-php": "^2.3 || ^3.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^12.0",
        "orchestra/testbench": "11.x-dev"
    },
    "scripts": {
        "test": "phpunit",
        "test:pgsql": "bash ../../tools/test-postgres-package.sh .",
        "test:opensearch": "bash ../../tools/test-opensearch-package.sh ."
    },
    "autoload": {
        "psr-4": {
            "Congraph\\EntityElastic\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
